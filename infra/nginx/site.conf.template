# Template for an operator-owned HTTPS deployment, not installed automatically.
# Substitute ONLY SMO_DOMAIN and SMO_PROXY_SECRET. Preserve nginx $variables.
# App port must bind to 127.0.0.1:3000; no direct public access to it.
log_format smo_private '$status $request_method $request_time';
limit_req_zone $binary_remote_addr zone=smo_auth_ip:10m rate=5r/s;
limit_req_zone $server_name zone=smo_auth_capacity:1m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=smo_connections:10m;
server {
 listen 443 ssl;
 server_name ${SMO_DOMAIN};
 ssl_certificate /etc/letsencrypt/live/${SMO_DOMAIN}/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/${SMO_DOMAIN}/privkey.pem;
 access_log /var/log/nginx/smo-access.log smo_private;
 error_log /dev/null; # Default nginx error records may contain request URLs/IPs.
 client_max_body_size 51m;
 client_body_timeout 30s;
 client_header_timeout 10s;
 limit_conn smo_connections 20;
 location / {
  proxy_http_version 1.1;
  proxy_request_buffering off;
  proxy_buffering off;
  proxy_pass http://127.0.0.1:3000;
  proxy_read_timeout 480s;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-SMO-Client-IP $remote_addr;
  proxy_set_header X-SMO-Proxy-Key ${SMO_PROXY_SECRET};
  proxy_no_cache 1;
  proxy_cache_bypass 1;
 }
 location /api/auth/ {
  client_max_body_size 16k;
  limit_req zone=smo_auth_ip burst=20 nodelay;
  limit_req zone=smo_auth_capacity burst=30 nodelay;
  limit_req_status 429;
  proxy_http_version 1.1;
  proxy_request_buffering off;
  proxy_buffering off;
  proxy_pass http://127.0.0.1:3000;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-SMO-Client-IP $remote_addr;
  proxy_set_header X-SMO-Proxy-Key ${SMO_PROXY_SECRET};
  add_header Cache-Control "private, no-store" always;
 }
}
