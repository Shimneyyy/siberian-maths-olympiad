generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TECHNICAL_ADMIN
  STUDENT
  CHIEF_ORGANIZER
  VENUE_ORGANIZER
}

model User {
  announcements Announcement[]
  notificationEvents OutboxEvent[]
  id               String                 @id @default(uuid()) @db.Uuid
  email            String                 @unique @db.VarChar(254)
  name             String
  emailVerified    Boolean                @default(false)
  image            String?
  twoFactorEnabled Boolean                @default(false)
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  editionGrants    EditionStaffGrant[]
  venueAssignments VenueStaffAssignment[]
  role             Role                   @default(STUDENT)
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @db.Timestamptz(3)
  profile          StudentProfile?
  consents         ConsentRecord[]
  corrections      ParticipationCorrection[]
  attendanceEdits  Attendance[]
  participations   Participation[]
}

model University {
  teams Team[]
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  abbreviation   String
  active         Boolean          @default(true)
  profiles       StudentProfile[]
  participations Participation[]
}

model CourseOption {
  id             String           @id @default(uuid()) @db.Uuid
  label          String
  active         Boolean          @default(true)
  profiles       StudentProfile[]
  participations Participation[]
}

model StudentProfile {
  revision Int @default(0)
  userId       String       @id @db.Uuid
  fullName     String
  universityId String       @db.Uuid
  courseId     String       @db.Uuid
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  university   University   @relation(fields: [universityId], references: [id], onDelete: Restrict)
  course       CourseOption @relation(fields: [courseId], references: [id], onDelete: Restrict)
}

model ConsentRecord {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  purpose     String
  textVersion String
  textHash    String    @db.Char(64)
  acceptedAt  DateTime  @default(now()) @db.Timestamptz(3)
  withdrawnAt DateTime? @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  participations Participation[]

  @@unique([id, userId])
  @@index([userId, purpose])
}

model OlympiadEdition {
  announcements Announcement[]
  notificationEvents OutboxEvent[]
  teams Team[]
  id                         String                 @id @default(uuid()) @db.Uuid
  year                       Int                    @unique
  title                      String
  timezone                   String                 @default("Asia/Novosibirsk")
  createdAt                  DateTime               @default(now()) @db.Timestamptz(3)
  registrationOpensAt        DateTime?              @db.Timestamptz(3)
  registrationClosesAt       DateTime?              @db.Timestamptz(3)
  registrationManuallyClosed Boolean                @default(false)
  isCurrent                  Boolean                @default(false)
  revision                   Int                    @default(0)
  participations             Participation[]
  staffGrants                EditionStaffGrant[]
  venues                     EditionVenue[]
  venueAssignments           VenueStaffAssignment[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model TwoFactor {
  id                      String    @id @default(uuid()) @db.Uuid
  secret                  String
  backupCodes             String
  userId                  String    @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)

  @@index([userId])
  @@index([secret])
}

model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
}

model EditionStaffGrant {
  userId    String          @db.Uuid
  editionId String          @db.Uuid
  revokedAt DateTime?       @db.Timestamptz(3)
  user      User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  edition   OlympiadEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)

  @@id([userId, editionId])
}

model Venue {
  id       String         @id @default(uuid()) @db.Uuid
  name     String
  editions EditionVenue[]
}

model EditionVenue {
  announcements Announcement[]
  notificationEvents OutboxEvent[]
  id             String                 @id @default(uuid()) @db.Uuid
  editionId      String                 @db.Uuid
  venueId        String                 @db.Uuid
  label          String?
  revision       Int                    @default(0)
  address        String
  room           String?
  instructions   String?
  active         Boolean                @default(true)
  edition        OlympiadEdition        @relation(fields: [editionId], references: [id], onDelete: Restrict)
  venue          Venue                  @relation(fields: [venueId], references: [id], onDelete: Restrict)
  assignments    VenueStaffAssignment[]
  participations Participation[]

  @@unique([editionId, venueId])
  @@unique([id, editionId])
}

model VenueStaffAssignment {
  userId         String          @db.Uuid
  editionId      String          @db.Uuid
  editionVenueId String          @db.Uuid
  revokedAt      DateTime?       @db.Timestamptz(3)
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  edition        OlympiadEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  editionVenue   EditionVenue    @relation(fields: [editionVenueId, editionId], references: [id, editionId], onDelete: Restrict)

  @@id([userId, editionVenueId])
  @@index([userId, editionId])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  objectType String
  objectId   String   @db.Uuid
  editionId  String?  @db.Uuid
  outcome    String
  details    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([editionId, createdAt])
}

enum ParticipationFormat {
  ONSITE
  REMOTE
}

enum RemoteZone {
  MSK
  NSK
}

enum ParticipationStatus {
  REGISTERED
  CANCELLED
}

model Participation {
  notificationJobs OutboxJob[]
  teamInvitations TeamInvitation[]
  captainTransfers CaptainTransfer[]
  @@unique([id, editionId])
  captainedTeam Team? @relation("TeamCaptain")
  teamMembership TeamMember?
  @@unique([id, editionId, universityId])
  revision Int @default(0)
  corrections ParticipationCorrection[]
  attendance Attendance?
  id                     String              @id @default(uuid()) @db.Uuid
  userId                 String              @db.Uuid
  editionId              String              @db.Uuid
  format                 ParticipationFormat
  editionVenueId         String?             @db.Uuid
  remoteZone             RemoteZone?
  status                 ParticipationStatus @default(REGISTERED)
  fullName               String
  universityId           String              @db.Uuid
  universityName         String
  universityAbbreviation String
  courseId               String              @db.Uuid
  courseLabel            String
  consentId              String              @db.Uuid
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  user                   User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  edition                OlympiadEdition     @relation(fields: [editionId], references: [id], onDelete: Restrict)
  editionVenue           EditionVenue?       @relation(fields: [editionVenueId, editionId], references: [id, editionId], onDelete: Restrict)
  university             University          @relation(fields: [universityId], references: [id], onDelete: Restrict)
  course                 CourseOption        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  consent                ConsentRecord       @relation(fields: [consentId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([userId, editionId])
  @@index([editionId, editionVenueId, id])
}

enum AttendanceStatus {
  UNMARKED
  PRESENT
  ABSENT
}

model Attendance {
  participationId String @id @db.Uuid
  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  status AttendanceStatus
  revision Int @default(1)
  markedById String @db.Uuid
  markedBy User @relation(fields: [markedById], references: [id], onDelete: Restrict)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model ParticipationCorrection {
  id String @id @default(uuid()) @db.Uuid
  participationId String @db.Uuid
  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  actorId String @db.Uuid
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  reason String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model Team {
  invitations TeamInvitation[]
  captainTransfer CaptainTransfer?
  id String @id @default(uuid()) @db.Uuid
  editionId String @db.Uuid
  edition OlympiadEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  universityId String @db.Uuid
  university University @relation(fields: [universityId], references: [id], onDelete: Restrict)
  slot Int
  name String
  coachName String
  captainParticipationId String @unique @db.Uuid
  @@unique([captainParticipationId, editionId, universityId])
  captain Participation @relation("TeamCaptain", fields: [captainParticipationId, editionId, universityId], references: [id, editionId, universityId], onDelete: Restrict)
  members TeamMember[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([editionId, universityId, slot])
  @@unique([id, editionId, universityId])
  @@unique([id, editionId])
}

model TeamMember {
  @@unique([participationId, editionId, universityId])
  participationId String @id @db.Uuid
  participation Participation @relation(fields: [participationId, editionId, universityId], references: [id, editionId, universityId], onDelete: Cascade)
  teamId String @db.Uuid
  team Team @relation(fields: [teamId, editionId, universityId], references: [id, editionId, universityId], onDelete: Cascade)
  editionId String @db.Uuid
  universityId String @db.Uuid
  joinedAt DateTime @default(now()) @db.Timestamptz(3)
}

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}
model TeamInvitation {
  id String @id @default(uuid()) @db.Uuid
  teamId String @db.Uuid
  editionId String @db.Uuid
  team Team @relation(fields: [teamId, editionId], references: [id, editionId], onDelete: Cascade)
  targetParticipationId String @db.Uuid
  target Participation @relation(fields: [targetParticipationId, editionId], references: [id, editionId], onDelete: Cascade)
  status TeamInvitationStatus @default(PENDING)
  revision Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([teamId, targetParticipationId])
}
model CaptainTransfer {
  @@unique([teamId, editionId, universityId])
  teamId String @id @db.Uuid
  editionId String @db.Uuid
  universityId String @db.Uuid
  team Team @relation(fields: [teamId, editionId, universityId], references: [id, editionId, universityId], onDelete: Cascade)
  targetParticipationId String @db.Uuid
  target Participation @relation(fields: [targetParticipationId, editionId, universityId], references: [id, editionId, universityId], onDelete: Cascade)
  revision Int @default(0)
}

enum OutboxEventKind {
  ANNOUNCEMENT
  MAIL_BATCH
  TRANSFER
}
enum OutboxJobStatus {
  READY
  PROCESSING
  SENT
  FAILED
  CANCELLED
}
model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  kind OutboxEventKind
  sourceId String @db.Uuid
  sourceRevision Int
  actorId String @db.Uuid
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  editionId String @db.Uuid
  edition OlympiadEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  editionVenueId String? @db.Uuid
  venue EditionVenue? @relation(fields: [editionVenueId, editionId], references: [id, editionId], onDelete: Restrict)
  subjectTemplate String
  bodyTemplate String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  jobs OutboxJob[]
  @@unique([kind, sourceId, sourceRevision])
  @@unique([id, editionId])
}
model OutboxJob {
  id String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  editionId String @db.Uuid
  event OutboxEvent @relation(fields: [eventId, editionId], references: [id, editionId], onDelete: Restrict)
  participationId String @db.Uuid
  participation Participation @relation(fields: [participationId, editionId], references: [id, editionId], onDelete: Restrict)
  status OutboxJobStatus @default(READY)
  attempts Int @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(3)
  leaseUntil DateTime? @db.Timestamptz(3)
  leaseToken String? @db.Uuid
  lastErrorCode String? @db.VarChar(80)
  providerMessageId String? @db.VarChar(500)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([eventId, participationId])
  @@index([status, availableAt])
}

model Announcement {
  id String @id @default(uuid()) @db.Uuid
  editionId String @db.Uuid
  editionVenueId String? @db.Uuid
  authorId String @db.Uuid
  title String @db.VarChar(200)
  body String
  important Boolean @default(false)
  revision Int @default(0)
  publishedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  edition OlympiadEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  editionVenue EditionVenue? @relation(fields: [editionVenueId, editionId], references: [id, editionId], onDelete: Restrict)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([editionId, publishedAt])
}
