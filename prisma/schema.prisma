generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TECHNICAL_ADMIN
  STUDENT
  CHIEF_ORGANIZER
  VENUE_ORGANIZER
}

model User {
  withdrawalRequests ConsentWithdrawalRequest[]
  accountImports NsuhwImportBatch[]
  diplomaBatches DiplomaBatch[]
  resultPublications ResultPublication[]
  resultImports ResultImportBatch[]
  nsuhwExportsAuthored NsuhwExportBatch[] @relation("NsuhwExportAuthor")
  nsuhwExportsConfirmed NsuhwExportBatch[] @relation("NsuhwExportConfirmer")
  nsuhwAccountsConfirmed PreparedExternalAccount[] @relation("NsuhwAccountConfirmer")
  preparedExternalAccount PreparedExternalAccount? @relation("PreparedOwner")
  nsuhwLoginName NsuhwLoginName?
  legacyNsuhwClaim LegacyNsuhwClaim? @relation("LegacyClaimOwner")
  legacyNsuhwApprovals LegacyNsuhwClaim[] @relation("LegacyClaimReviewer")
  mailBatches MailBatch[]
  announcements Announcement[]
  notificationEvents OutboxEvent[]
  id               String                 @id @default(uuid()) @db.Uuid
  email            String                 @unique @db.VarChar(254)
  name             String
  emailVerified    Boolean                @default(false)
  image            String?
  twoFactorEnabled Boolean                @default(false)
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  editionGrants    EditionStaffGrant[]
  venueAssignments VenueStaffAssignment[]
  role             Role                   @default(STUDENT)
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @db.Timestamptz(3)
  profile          StudentProfile?
  consents         ConsentRecord[]
  corrections      ParticipationCorrection[]
  attendanceEdits  Attendance[]
  participations   Participation[]
}

model University {
  teams Team[]
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  abbreviation   String
  active         Boolean          @default(true)
  profiles       StudentProfile[]
  participations Participation[]
}

model CourseOption {
  id             String           @id @default(uuid()) @db.Uuid
  label          String
  active         Boolean          @default(true)
  profiles       StudentProfile[]
  participations Participation[]
}

model StudentProfile {
  revision Int @default(0)
  userId       String       @id @db.Uuid
  fullName     String
  universityId String       @db.Uuid
  courseId     String       @db.Uuid
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  university   University   @relation(fields: [universityId], references: [id], onDelete: Restrict)
  course       CourseOption @relation(fields: [courseId], references: [id], onDelete: Restrict)
}

model ConsentRecord {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  purpose     String
  textVersion String
  textHash    String    @db.Char(64)
  acceptedAt  DateTime  @default(now()) @db.Timestamptz(3)
  withdrawnAt DateTime? @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  participations Participation[]

  @@unique([id, userId])
  @@index([userId, purpose])
}

model OlympiadEdition {
  accountImports NsuhwImportBatch[]
  diplomaBatches DiplomaBatch[]
  diplomaItems DiplomaItem[]
  diplomaDocuments DiplomaDocument[]
  diplomaVersions DiplomaVersion[]
  resultImports ResultImportBatch[]
  resultProblems EditionProblem[]
  individualResults IndividualResult[]
  nsuhwExports NsuhwExportBatch[]
  nsuhwAccountsConfirmed PreparedExternalAccount[]
  legacyNsuhwApprovals LegacyNsuhwClaim[]
  mailBatches MailBatch[]
  announcements Announcement[]
  notificationEvents OutboxEvent[]
  teams Team[]
  id                         String                 @id @default(uuid()) @db.Uuid
  year                       Int                    @unique
  title                      String
  timezone                   String                 @default("Asia/Novosibirsk")
  createdAt                  DateTime               @default(now()) @db.Timestamptz(3)
  registrationOpensAt        DateTime?              @db.Timestamptz(3)
  registrationClosesAt       DateTime?              @db.Timestamptz(3)
  registrationManuallyClosed Boolean                @default(false)
  isCurrent                  Boolean                @default(false)
  revision                   Int                    @default(0)
  participations             Participation[]
  staffGrants                EditionStaffGrant[]
  venues                     EditionVenue[]
  venueAssignments           VenueStaffAssignment[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model TwoFactor {
  id                      String    @id @default(uuid()) @db.Uuid
  secret                  String
  backupCodes             String
  userId                  String    @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)

  @@index([userId])
  @@index([secret])
}

model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
}

model EditionStaffGrant {
  userId    String          @db.Uuid
  editionId String          @db.Uuid
  revokedAt DateTime?       @db.Timestamptz(3)
  user      User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  edition   OlympiadEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)

  @@id([userId, editionId])
}

model Venue {
  id       String         @id @default(uuid()) @db.Uuid
  name     String
  editions EditionVenue[]
}

model EditionVenue {
  mailBatches MailBatch[]
  announcements Announcement[]
  notificationEvents OutboxEvent[]
  id             String                 @id @default(uuid()) @db.Uuid
  editionId      String                 @db.Uuid
  venueId        String                 @db.Uuid
  label          String?
  revision       Int                    @default(0)
  address        String
  room           String?
  instructions   String?
  active         Boolean                @default(true)
  edition        OlympiadEdition        @relation(fields: [editionId], references: [id], onDelete: Restrict)
  venue          Venue                  @relation(fields: [venueId], references: [id], onDelete: Restrict)
  assignments    VenueStaffAssignment[]
  participations Participation[]

  @@unique([editionId, venueId])
  @@unique([id, editionId])
}

model VenueStaffAssignment {
  userId         String          @db.Uuid
  editionId      String          @db.Uuid
  editionVenueId String          @db.Uuid
  revokedAt      DateTime?       @db.Timestamptz(3)
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  edition        OlympiadEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  editionVenue   EditionVenue    @relation(fields: [editionVenueId, editionId], references: [id, editionId], onDelete: Restrict)

  @@id([userId, editionVenueId])
  @@index([userId, editionId])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  objectType String
  objectId   String   @db.Uuid
  editionId  String?  @db.Uuid
  outcome    String
  details    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([editionId, createdAt])
}

enum ParticipationFormat {
  ONSITE
  REMOTE
}

enum RemoteZone {
  MSK
  NSK
}

enum ParticipationStatus {
  REGISTERED
  CANCELLED
}

model Participation {
  diplomaItems DiplomaItem[]
  diplomaDocuments DiplomaDocument[]
  individualResults IndividualResult[]
  notificationJobs OutboxJob[]
  teamInvitations TeamInvitation[]
  captainTransfers CaptainTransfer[]
  @@unique([id, editionId])
  captainedTeam Team? @relation("TeamCaptain")
  teamMembership TeamMember?
  @@unique([id, editionId, universityId])
  revision Int @default(0)
  corrections ParticipationCorrection[]
  attendance Attendance?
  id                     String              @id @default(uuid()) @db.Uuid
  userId                 String              @db.Uuid
  editionId              String              @db.Uuid
  format                 ParticipationFormat
  editionVenueId         String?             @db.Uuid
  remoteZone             RemoteZone?
  status                 ParticipationStatus @default(REGISTERED)
  fullName               String
  universityId           String              @db.Uuid
  universityName         String
  universityAbbreviation String
  courseId               String              @db.Uuid
  courseLabel            String
  consentId              String              @db.Uuid
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  user                   User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  edition                OlympiadEdition     @relation(fields: [editionId], references: [id], onDelete: Restrict)
  editionVenue           EditionVenue?       @relation(fields: [editionVenueId, editionId], references: [id, editionId], onDelete: Restrict)
  university             University          @relation(fields: [universityId], references: [id], onDelete: Restrict)
  course                 CourseOption        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  consent                ConsentRecord       @relation(fields: [consentId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([userId, editionId])
  @@index([editionId, editionVenueId, id])
}

enum AttendanceStatus {
  UNMARKED
  PRESENT
  ABSENT
}

model Attendance {
  participationId String @id @db.Uuid
  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  status AttendanceStatus
  revision Int @default(1)
  markedById String @db.Uuid
  markedBy User @relation(fields: [markedById], references: [id], onDelete: Restrict)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model ParticipationCorrection {
  id String @id @default(uuid()) @db.Uuid
  participationId String @db.Uuid
  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  actorId String @db.Uuid
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  reason String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model Team {
  invitations TeamInvitation[]
  captainTransfer CaptainTransfer?
  id String @id @default(uuid()) @db.Uuid
  editionId String @db.Uuid
  edition OlympiadEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  universityId String @db.Uuid
  university University @relation(fields: [universityId], references: [id], onDelete: Restrict)
  slot Int
  name String
  coachName String
  captainParticipationId String @unique @db.Uuid
  @@unique([captainParticipationId, editionId, universityId])
  captain Participation @relation("TeamCaptain", fields: [captainParticipationId, editionId, universityId], references: [id, editionId, universityId], onDelete: Restrict)
  members TeamMember[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([editionId, universityId, slot])
  @@unique([id, editionId, universityId])
  @@unique([id, editionId])
}

model TeamMember {
  @@unique([participationId, editionId, universityId])
  participationId String @id @db.Uuid
  participation Participation @relation(fields: [participationId, editionId, universityId], references: [id, editionId, universityId], onDelete: Cascade)
  teamId String @db.Uuid
  team Team @relation(fields: [teamId, editionId, universityId], references: [id, editionId, universityId], onDelete: Cascade)
  editionId String @db.Uuid
  universityId String @db.Uuid
  joinedAt DateTime @default(now()) @db.Timestamptz(3)
}

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}
model TeamInvitation {
  id String @id @default(uuid()) @db.Uuid
  teamId String @db.Uuid
  editionId String @db.Uuid
  team Team @relation(fields: [teamId, editionId], references: [id, editionId], onDelete: Cascade)
  targetParticipationId String @db.Uuid
  target Participation @relation(fields: [targetParticipationId, editionId], references: [id, editionId], onDelete: Cascade)
  status TeamInvitationStatus @default(PENDING)
  revision Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([teamId, targetParticipationId])
}
model CaptainTransfer {
  @@unique([teamId, editionId, universityId])
  teamId String @id @db.Uuid
  editionId String @db.Uuid
  universityId String @db.Uuid
  team Team @relation(fields: [teamId, editionId, universityId], references: [id, editionId, universityId], onDelete: Cascade)
  targetParticipationId String @db.Uuid
  target Participation @relation(fields: [targetParticipationId, editionId, universityId], references: [id, editionId, universityId], onDelete: Cascade)
  revision Int @default(0)
}

enum OutboxEventKind {
  ANNOUNCEMENT
  MAIL_BATCH
  TRANSFER
  EXTERNAL_ACCOUNT_READY
  RESULTS_PUBLISHED
  DIPLOMAS_PUBLISHED
}
enum OutboxJobStatus {
  READY
  PROCESSING
  SENT
  FAILED
  CANCELLED
}
model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  kind OutboxEventKind
  sourceId String @db.Uuid
  sourceRevision Int
  actorId String @db.Uuid
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  editionId String @db.Uuid
  edition OlympiadEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  editionVenueId String? @db.Uuid
  venue EditionVenue? @relation(fields: [editionVenueId, editionId], references: [id, editionId], onDelete: Restrict)
  subjectTemplate String
  bodyTemplate String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  jobs OutboxJob[]
  @@unique([kind, sourceId, sourceRevision])
  @@unique([id, editionId])
}
model OutboxJob {
  id String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  editionId String @db.Uuid
  event OutboxEvent @relation(fields: [eventId, editionId], references: [id, editionId], onDelete: Restrict)
  participationId String @db.Uuid
  participation Participation @relation(fields: [participationId, editionId], references: [id, editionId], onDelete: Restrict)
  status OutboxJobStatus @default(READY)
  attempts Int @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(3)
  leaseUntil DateTime? @db.Timestamptz(3)
  leaseToken String? @db.Uuid
  lastErrorCode String? @db.VarChar(80)
  providerMessageId String? @db.VarChar(500)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([eventId, participationId])
  @@index([status, availableAt])
}

model Announcement {
  id String @id @default(uuid()) @db.Uuid
  editionId String @db.Uuid
  editionVenueId String? @db.Uuid
  authorId String @db.Uuid
  title String @db.VarChar(200)
  body String
  important Boolean @default(false)
  revision Int @default(0)
  publishedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  edition OlympiadEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  editionVenue EditionVenue? @relation(fields: [editionVenueId, editionId], references: [id, editionId], onDelete: Restrict)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([editionId, publishedAt])
}

model MailBatch {
  id String @id @db.Uuid
  editionId String @db.Uuid
  editionVenueId String? @db.Uuid
  actorId String @db.Uuid
  repeatOf String? @db.Uuid
  subjectTemplate String @db.VarChar(200)
  bodyTemplate String
  publishedAt DateTime @default(now()) @db.Timestamptz(3)
  edition OlympiadEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  editionVenue EditionVenue? @relation(fields: [editionVenueId, editionId], references: [id, editionId], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  previous MailBatch? @relation("MailRepeat", fields: [repeatOf], references: [id], onDelete: Restrict)
  repeats MailBatch[] @relation("MailRepeat")
  @@index([editionId, publishedAt])
}

model LegacyNsuhwClaim {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  login String @db.VarChar(254)
  revision Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  approvedAt DateTime? @db.Timestamptz(3)
  approvedById String? @db.Uuid
  approvedEditionId String? @db.Uuid
  user User @relation("LegacyClaimOwner", fields: [userId], references: [id], onDelete: Restrict)
  approvedBy User? @relation("LegacyClaimReviewer", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedEdition OlympiadEdition? @relation(fields: [approvedEditionId], references: [id], onDelete: Restrict)
  @@index([approvedAt, createdAt])
}

model NsuhwLoginName {
  userId String @id @db.Uuid
  firstNameLatin String @db.VarChar(80)
  lastNameLatin String @db.VarChar(80)
  revision Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model PreparedExternalAccount {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  login String @unique @db.VarChar(254)
  credentialVersion Int @default(1)
  keyVersion String @db.VarChar(64)
  secretEnvelope Json
  revision Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  confirmedAt DateTime? @db.Timestamptz(3)
  confirmedById String? @db.Uuid
  confirmedEditionId String? @db.Uuid
  confirmedBy User? @relation("NsuhwAccountConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  confirmedEdition OlympiadEdition? @relation(fields: [confirmedEditionId], references: [id], onDelete: Restrict)
  user User @relation("PreparedOwner", fields: [userId], references: [id], onDelete: Restrict)
  @@index([keyVersion])
}

model NsuhwExportBatch {
  id String @id @default(uuid()) @db.Uuid
  editionId String @db.Uuid
  actorId String @db.Uuid
  items Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  confirmedAt DateTime? @db.Timestamptz(3)
  confirmedById String? @db.Uuid
  edition OlympiadEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  actor User @relation("NsuhwExportAuthor", fields: [actorId], references: [id], onDelete: Restrict)
  confirmedBy User? @relation("NsuhwExportConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  @@index([editionId, createdAt])
}


enum ResultKind {
  PRELIMINARY
  FINAL
}

model ResultImportBatch {
  publication ResultPublication?
  id String @id @db.Uuid
  editionId String @db.Uuid
  actorId String @db.Uuid
  kind ResultKind
  sourceHash String @db.Char(64)
  importedCount Int
  rejectedCount Int
  report Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  edition OlympiadEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  results IndividualResult[]
  @@unique([id, editionId, kind])
  @@index([editionId, createdAt])
}

model EditionProblem {
  id String @id @default(uuid()) @db.Uuid
  editionId String @db.Uuid
  ordinal Int
  edition OlympiadEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  scores ResultProblemScore[]
  @@unique([editionId, ordinal])
  @@unique([id, editionId])
}

model IndividualResult {
  id String @id @default(uuid()) @db.Uuid
  editionId String @db.Uuid
  participationId String @db.Uuid
  batchId String @db.Uuid
  kind ResultKind
  total Int?
  prize String? @db.VarChar(200)
  participation Participation @relation(fields: [participationId, editionId], references: [id, editionId], onDelete: Restrict)
  edition OlympiadEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  batch ResultImportBatch @relation(fields: [batchId, editionId, kind], references: [id, editionId, kind], onDelete: Restrict)
  scores ResultProblemScore[]
  @@unique([participationId, kind])
  @@unique([id, editionId])
  @@index([editionId, kind])
}

model ResultProblemScore {
  resultId String @db.Uuid
  problemId String @db.Uuid
  editionId String @db.Uuid
  score Int?
  result IndividualResult @relation(fields: [resultId, editionId], references: [id, editionId], onDelete: Restrict)
  problem EditionProblem @relation(fields: [problemId, editionId], references: [id, editionId], onDelete: Restrict)
  @@id([resultId, problemId])
}

model ResultPublication {
  batchId String @id @db.Uuid
  actorId String @db.Uuid
  publishedAt DateTime @default(now()) @db.Timestamptz(3)
  batch ResultImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
}

model DiplomaBatch {
  id String @id @db.Uuid
  editionId String @db.Uuid
  actorId String @db.Uuid
  archiveHash String @db.Char(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  appliedAt DateTime? @db.Timestamptz(3)
  selectionHash String? @db.Char(64)
  publishedAt DateTime? @db.Timestamptz(3)
  edition OlympiadEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  items DiplomaItem[]
  @@unique([id, editionId])
  @@index([editionId, createdAt])
}
model DiplomaItem {
  id String @id @default(uuid()) @db.Uuid
  batchId String @db.Uuid
  editionId String @db.Uuid
  ordinal Int
  fileName String
  participationId String? @db.Uuid
  error String?
  fileKey String? @db.Uuid
  fileHash String? @db.Char(64)
  size Int?
  pages Int?
  inspectedAt DateTime? @db.Timestamptz(3)
  batch DiplomaBatch @relation(fields: [batchId, editionId], references: [id, editionId], onDelete: Restrict)
  edition OlympiadEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  participation Participation? @relation(fields: [participationId, editionId], references: [id, editionId], onDelete: Restrict)
  version DiplomaVersion?
  @@unique([batchId, ordinal])
  @@unique([id, editionId])
}
model DiplomaDocument {
  id String @id @default(uuid()) @db.Uuid
  editionId String @db.Uuid
  participationId String @db.Uuid
  revision Int @default(0)
  currentVersionId String? @unique @db.Uuid
  edition OlympiadEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  participation Participation @relation(fields: [participationId, editionId], references: [id, editionId], onDelete: Restrict)
  versions DiplomaVersion[] @relation("DiplomaVersions")
  @@unique([currentVersionId, id])
  currentVersion DiplomaVersion? @relation("CurrentDiploma", fields: [currentVersionId, id], references: [id, documentId], onDelete: Restrict)
  @@unique([id, editionId])
}
model DiplomaVersion {
  id String @id @default(uuid()) @db.Uuid
  editionId String @db.Uuid
  documentId String @db.Uuid
  itemId String @unique @db.Uuid
  baseRevision Int
  document DiplomaDocument @relation("DiplomaVersions", fields: [documentId, editionId], references: [id, editionId], onDelete: Restrict)
  edition OlympiadEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  @@unique([itemId, editionId])
  item DiplomaItem @relation(fields: [itemId, editionId], references: [id, editionId], onDelete: Restrict)
  currentFor DiplomaDocument? @relation("CurrentDiploma")
  @@unique([id, documentId])
}

model NsuhwImportBatch {
  id String @id @db.Uuid
  editionId String @db.Uuid
  actorId String @db.Uuid
  sourceMac String @db.Char(64)
  importedCount Int
  rejectedCount Int
  report Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  edition OlympiadEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([editionId, createdAt])
}

model ConsentWithdrawalRequest {
  id String @id @db.Uuid
  userId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  reviewedAt DateTime? @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
}
