{
  "name": "siberian-maths-olympiad",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "worker": "tsx scripts/mail-worker.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "test:db": "tsx --test --test-concurrency=1 tests/outbox.test.ts tests/teams.test.ts tests/migration.test.ts tests/admin.test.ts tests/database.test.ts tests/access.test.ts tests/staff.test.ts tests/bootstrap.test.ts tests/olympiad.test.ts tests/registrations.test.ts",
    "test:live": "node scripts/test-http.mjs tests/live.test.ts",
    "test:http": "node scripts/test-http.mjs",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "staff:bootstrap": "tsx scripts/bootstrap-chief.ts",
    "dev:setup": "node scripts/init-env.mjs",
    "edition:create": "tsx scripts/create-edition.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "1.5.0",
    "better-auth": "1.7.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.4.5",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "playwright": "1.65.0",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
