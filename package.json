    "test:live": "node scripts/test-http.mjs tests/live.test.ts",
    "test:http": "node scripts/test-http.mjs",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "staff:bootstrap": "tsx scripts/bootstrap-chief.ts",
