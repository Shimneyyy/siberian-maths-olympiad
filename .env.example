# Только локальная разработка; не использовать эти реквизиты в production.
DATABASE_URL="postgresql://smo:smo_local_only@127.0.0.1:5432/smo?schema=public"
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"

# Сгенерируйте случайный секрет: openssl rand -hex 32. Не коммитить его.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Только вымышленные данные, почта @example.test; запрещено в production.
DEMO_REGISTRATION="false"
SMTP_FROM="СМО <no-reply@example.test>"
# Independent demo-only keyring; create with DEMO_REGISTRATION=true npm run nsuhw:keys -- init
NSUHW_KEYRING_FILE=".local/nsuhw-keyring.json"

# Per application process; budget total connections across app/worker/instances.
DATABASE_POOL_MAX="20"

# Refuse scans when the loaded signature database is older than this many hours.
# 168 is the default. Synthetic pinned-image tests may explicitly use 720.
CLAMAV_MAX_DATABASE_AGE_HOURS="168"

# Enable only together with a proxy that strips and overwrites the X-SMO headers.
# Use a dedicated random secret, distinct from auth and encryption keys.
AUTH_TRUSTED_PROXY_SECRET=""
AUTH_IP_MAX_PER_MINUTE="300"
