# Только локальная разработка; не использовать эти реквизиты в production.
DATABASE_URL="postgresql://smo:smo_local_only@127.0.0.1:5432/smo?schema=public"
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"

# Сгенерируйте случайный секрет: openssl rand -hex 32. Не коммитить его.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Только вымышленные данные, почта @example.test; запрещено в production.
DEMO_REGISTRATION="false"
SMTP_FROM="СМО <no-reply@example.test>"
# Independent demo-only keyring; create with DEMO_REGISTRATION=true npm run nsuhw:keys -- init
NSUHW_KEYRING_FILE=".local/nsuhw-keyring.json"
